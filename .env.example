# Настройки ClipFactory (необязательно). Скопируйте файл в .env и измените при необходимости.

# Адрес и порт локального сервера. По умолчанию программа доступна только с этого компьютера.
CLIPFACTORY_HOST=127.0.0.1
CLIPFACTORY_PORT=8765

# Папка для видео, базы данных и моделей (по умолчанию — storage внутри папки программы)
# CLIPFACTORY_STORAGE=D:\ClipFactoryData

# Явные пути к FFmpeg, если он установлен в нестандартное место
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
